    "license": {
        "identifier": "GPL-3.0-or-later",
        "url": "https://github.com/bitwarden/clients/blob/main/LICENSE.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/bitwarden/clients/releases/download/desktop-v2026.10.2/Bitwarden-2026.10.2-x64.appx",
            "hash": "9fb209179e99bd3c56028e138b699f642ce254b4badf70dc09e1d7771860ed9a"
        },
        "arm64": {
            "url": "https://github.com/bitwarden/clients/releases/download/desktop-v2026.10.2/Bitwarden-2026.10.2-arm64.appx",
            "hash": "4c9bc950c7c33e4a8c97a526c0922e672d5f55bf9732c1cd0c500980e1e584ee"
        }
    },
    "pre_install": [
        "# Install Appx package",
        "# note: using '3>$null' to omit warning message. Also, '-SkipEditionCheck' does not work for Appx module",
        "if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
        "Add-AppxPackage \"$dir\\$fname\""
    ],
    "post_install": "Remove-Item \"$dir\\$fname\" -ErrorAction SilentlyContinue",
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    if ($PSVersionTable.PSVersion.Major -ge 6) { Import-Module Appx -UseWindowsPowerShell 3>$null }",
        "    Get-AppxPackage '8bitSolutionsLLC.bitwardendesktop' | Remove-AppxPackage",
        "}"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/bitwarden/clients/releases",
        "jp": "$[*].tag_name",
        "re": "desktop-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bitwarden/clients/releases/download/desktop-v$version/Bitwarden-$version-x64.appx"
            },
            "arm64": {
                "url": "https://github.com/bitwarden/clients/releases/download/desktop-v$version/Bitwarden-$version-arm64.appx"
            }
        }
    }
}
