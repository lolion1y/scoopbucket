            "hash": "22414a160d7ef74e88fd2c03fac1152a07abd7272b4b096478974ba0ceb6ab5f",
            "bin": "Imagine64.exe",
            "shortcuts": [
                [
                    "Imagine64.exe",
                    "Imagine"
                ]
            ]
        },
        "32bit": {
            "url": "https://raw.githubusercontent.com/nyam1003/imagine/main/Imagine_2.5.4_Unicode_Full.zip",
